GEMINI_API_KEY=your_key_here

# Paid (best handwriting accuracy; requires billing on the API project):
# GEMINI_MODEL=gemini-3.1-pro-preview

# Free tier for new API keys (2.5 Flash/Lite return 404 for new users as of 2026):
#   gemini-3.5-flash          — best free accuracy (recommended)
#   gemini-3-flash-preview    — also works
#   gemini-3.1-flash-lite     — faster/cheaper, slightly weaker
GEMINI_MODEL=gemini-3.5-flash
