GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium

# local is isolated development; supabase is the shared deployment.
WORKBENCH_BACKEND=local
SUPABASE_URL=https://ynsutdkbpzrgfetnrxax.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key
# Server only. Never expose in HTML, browser bundles, logs or commits.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=census-media
WORKBENCH_ALLOWED_DOMAINS=utexas.edu,eid.utexas.edu,my.utexas.edu
# Exact account exceptions; match the private database allowlist.
WORKBENCH_ALLOWED_EMAILS=
WORKBENCH_SESSION_COOKIE=session
WORKBENCH_PUBLIC_ORIGIN=http://localhost:8000
WORKBENCH_EXTRACTION_ENABLED=false
WORKBENCH_MAX_PAGES_PER_RUN=10
WORKBENCH_MAX_UPLOAD_BYTES=26214400
WORKBENCH_MAX_MODEL_CALLS_PER_RUN=0
WORKBENCH_ALERT_EMAIL=
WORKBENCH_OWNER_EMAIL=

# Operator backup identity only; DO NOT inject these into the web/worker.
# PostgreSQL direct/session connection used by pg_dump, including TLS settings.
SUPABASE_DB_URL=
SUPABASE_RECOVERY_URL=
SUPABASE_RECOVERY_SECRET_KEY=
WORKBENCH_RECOVERY_BUCKET=census-recovery
WORKBENCH_RECOVERY_PROJECT=
