# Shared by web, worker, CLI and benchmark. Copy to .env; never commit credentials.
CENSUS_PROVIDER=portkey
PORTKEY_API_KEY=your_key_here
# Alternatively mount a secret file in both containers and use this variable.
# PORTKEY_API_KEY_FILE=/run/secrets/portkey_api_key
PORTKEY_MODEL=@your_anthropic_catalog/claude-opus-5-5
PORTKEY_COMPARISON_MODEL=@your_openai_catalog/gpt-6-astra
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_TIMEOUT_SECONDS=240
PORTKEY_MAX_ATTEMPTS=3
PORTKEY_MAX_OUTPUT_TOKENS=16000
WORKBENCH_PORT=8000

# Optional legacy mode: change CENSUS_PROVIDER to gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_BUDGET=0
