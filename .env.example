GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium

# local is isolated development; firebase is the shared deployment.
WORKBENCH_BACKEND=local
FIREBASE_PROJECT_ID=poc-textual
FIREBASE_STORAGE_BUCKET=poc-textual.firebasestorage.app
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=poc-textual.firebaseapp.com
FIREBASE_APP_ID=your_firebase_app_id
WORKBENCH_ALLOWED_DOMAINS=utexas.edu
WORKBENCH_SESSION_COOKIE=session
# Cloud Run uses its assigned service identity. Local cloud development only:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
WORKBENCH_PUBLIC_ORIGIN=http://localhost:8000
# Paid extraction is disabled until these explicit limits are configured.
WORKBENCH_EXTRACTION_ENABLED=false
WORKBENCH_MAX_PAGES_PER_RUN=10
WORKBENCH_MAX_UPLOAD_BYTES=26214400
WORKBENCH_MAX_MODEL_CALLS_PER_RUN=0
# Required for deployment/recovery; fill with institutional owners/resources.
WORKBENCH_RECOVERY_PROJECT=
WORKBENCH_RECOVERY_BUCKET=
WORKBENCH_ALERT_EMAIL=
WORKBENCH_OWNER_EMAIL=
